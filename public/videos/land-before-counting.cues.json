{
  "film": "land-before-counting.mp4",
  "durationSec": 54.539,
  "cues": [
    {
      "index": 0,
      "start": 0,
      "end": 1.859,
      "lines": [
        "Over ten thousand years ago,"
      ]
    },
    {
      "index": 1,
      "start": 1.879,
      "end": 4.599,
      "lines": [
        "a young boy named",
        "Tarek lived in a small"
      ]
    },
    {
      "index": 2,
      "start": 4.619,
      "end": 7.079,
      "lines": [
        "village at the edge",
        "of the wild hills."
      ]
    },
    {
      "index": 3,
      "start": 7.659,
      "end": 10.439,
      "lines": [
        "Every morning, he led his",
        "family's flock of sheep"
      ]
    },
    {
      "index": 4,
      "start": 10.459,
      "end": 12.939,
      "lines": [
        "out to graze in the",
        "sunlit meadows."
      ]
    },
    {
      "index": 5,
      "start": 13.579,
      "end": 14.559,
      "lines": [
        "But each evening,"
      ]
    },
    {
      "index": 6,
      "start": 14.579,
      "end": 16.44,
      "lines": [
        "he had to make sure",
        "all the sheep came"
      ]
    },
    {
      "index": 7,
      "start": 16.46,
      "end": 17.7,
      "lines": [
        "back safely."
      ]
    },
    {
      "index": 8,
      "start": 18.28,
      "end": 20.139,
      "lines": [
        "If even one was left behind,"
      ]
    },
    {
      "index": 9,
      "start": 20.159,
      "end": 21.819,
      "lines": [
        "the wolves would find it."
      ]
    },
    {
      "index": 10,
      "start": 22.579,
      "end": 24.239,
      "lines": [
        "There was just one problem."
      ]
    },
    {
      "index": 11,
      "start": 24.339,
      "end": 26.399,
      "lines": [
        "Tarek didn't know how to count."
      ]
    },
    {
      "index": 12,
      "start": 26.759,
      "end": 29.499,
      "lines": [
        "It wasn't that Tarek hadn't",
        "learned how to count."
      ]
    },
    {
      "index": 13,
      "start": 29.679,
      "end": 31.84,
      "lines": [
        "It was that this was",
        "a long time ago,"
      ]
    },
    {
      "index": 14,
      "start": 31.86,
      "end": 34.24,
      "lines": [
        "and counting hadn't",
        "been invented yet."
      ]
    },
    {
      "index": 15,
      "start": 34.779,
      "end": 37.639,
      "lines": [
        "Like everyone, he only",
        "had words for \"one,\""
      ]
    },
    {
      "index": 16,
      "start": 37.659,
      "end": 39.299,
      "lines": [
        "\"two,\" and \"many.\""
      ]
    },
    {
      "index": 17,
      "start": 39.739,
      "end": 42.159,
      "lines": [
        "He couldn't say how",
        "many sheep there were,"
      ]
    },
    {
      "index": 18,
      "start": 42.179,
      "end": 43.979,
      "lines": [
        "only that there",
        "were a lot of them."
      ]
    },
    {
      "index": 19,
      "start": 44.739,
      "end": 46.459,
      "lines": [
        "And yet, every day,"
      ]
    },
    {
      "index": 20,
      "start": 46.479,
      "end": 49.439,
      "lines": [
        "Tarek made sure all the",
        "sheep came back safely"
      ]
    },
    {
      "index": 21,
      "start": 49.459,
      "end": 51.739,
      "lines": [
        "before daylight",
        "turned to nighttime."
      ]
    },
    {
      "index": 22,
      "start": 52.259,
      "end": 53.499,
      "lines": [
        "How did he do it?"
      ]
    }
  ]
}
