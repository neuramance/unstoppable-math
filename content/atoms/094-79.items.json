  "items": [
    {
      "src": "II:3",
      "role": "model",
      "mode": "frac",
      "prompt": "The column a digit sits in tells us what kind of part it counts: tenths… hundredths… or thousandths. For example, here is 0.09. Zero tenths, and nine hundredths.",
      "expr": "0.09 =",
      "frac": { "num": null, "den": null },
      "expected": "9/100",
      "demo": "Zero tenths, and nine hundredths: *9/100*."
    },
    {
      "src": "II:5",
      "role": "model",
      "mode": "frac",
      "prompt": "Watch what I change. Nine tenths.",
      "expr": "0.9 =",
      "frac": { "num": null, "den": null },
      "expected": "9/10",
      "demo": "Nine tenths: *9/10*."
    },
    {
      "src": "II:7",
      "role": "model",
      "mode": "frac",
      "prompt": "Watch what I change again. Three tenths.",
      "expr": "0.3 =",
      "frac": { "num": null, "den": null },
      "expected": "3/10",
      "demo": "Three tenths: *3/10*. Each time, we count the digits to the right of the point. First column is tenths, second column is hundredths, third column is thousandths."
    },
